FROM ubuntu:24.04 AS builder

ENV debian_frontend=noninteractive

ARG SOURCE_REPO=https://github.com/HavenWoW/BFA-HavenCore.git
ARG SOURCE_BRANCH=main
ARG SOURCE_COMMIT=""

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --no-checkout --depth=1 --filter=tree:0 "${SOURCE_REPO}" --branch "${SOURCE_BRANCH}" /tmp/src \
    && git -C /tmp/src sparse-checkout set --no-cone /sql \
    && git -C /tmp/src checkout \
    && rm -rf /tmp/src/sql/tools \
    && cp -r /tmp/src/sql/ /opt/havencore-sql/ \
    && rm -rf /tmp/src

FROM ubuntu:24.04 AS runtime
ENV debian_frontend=noninteractive

COPY --from=builder --chown=1000:1000 /opt/havencore-sql/ /opt/havencore/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        default-mysql-client \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && userdel --remove ubuntu \
    && groupadd --gid 1000 havencore \
    && useradd --uid 1000 --gid havencore --home-dir /opt/havencore --shell /usr/sbin/nologin havencore

COPY --chown=1000:1000 entrypoint.sh /opt/havencore/entrypoint.sh
RUN chmod +x /opt/havencore/entrypoint.sh

USER havencore

WORKDIR /opt/havencore
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/havencore/entrypoint.sh"]
