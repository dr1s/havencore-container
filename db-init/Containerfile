FROM ubuntu:24.04

ENV debian_frontend=noninteractive

ARG SOURCE_REPO=https://github.com/HavenWoW/BFA-HavenCore.git
ARG SOURCE_BRANCH=main
ARG SOURCE_COMMIT=""

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        default-mysql-client \
        ca-certificates \
        git \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --no-checkout --depth=1 --filter=tree:0 "${SOURCE_REPO}" --branch "${SOURCE_BRANCH}" /tmp/src \
    && git -C /tmp/src sparse-checkout set --no-cone /sql \
    && git -C /tmp/src checkout \
    && cp -r /tmp/src/sql/ /opt/havencore-sql/ \
    && rm -rf /tmp/src

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
