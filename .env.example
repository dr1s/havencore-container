# Container image
HAVENCORE_SERVER_IMAGE=ghcr.io/dr1s/havencore-server:latest
HAVENCORE_DBINIT_IMAGE=ghcr.io/dr1s/havencore-db-init:latest

# Database connection settings
DB_HOST=db
DB_PORT=3306
DB_USER=havencore
DB_PASSWORD=havencore
DB_ROOT_PASSWORD=havencore

# Optional: update the realmlist address when the worldserver IP changes
# WORLD_IP=192.168.1.10

# Optional: update the realmlist name
# WORLD_NAME=My Realm

# Optional: reapply SQL updates whose file hash has changed (default: 0)
# REAPPLY_CHANGED_DATABASE_UPDATES=1

# Optional: custom database names (default: bfa_auth, bfa_characters, bfa_world, bfa_hotfixes)
# DB_LOGIN=bfa_auth
# DB_WORLD=bfa_world
# DB_CHAR=bfa_characters
# DB_HOTFIX=bfa_hotfixes

# Optional volume names/paths
# DB_DATA_VOL=dbdata
# CLIENT_DATA_VOL=./data
# LOGS_VOL=logs
